	partition 'P&L Lines' = calculated
		mode: import
		source = DATATABLE("Line", STRING, "Sort", INTEGER, "Line Label", STRING, "Explanation", STRING, {{"Revenue", 1, "Revenue  ⓘ", "Income generated from the company's core operations before any costs or expenses are deducted."}, {"Cost of Goods Sold", 2, "Cost of Goods Sold  ⓘ", "Direct costs required to deliver the products and services sold during the period."}, {"Gross Profit", 3, "Gross Profit  ⓘ", "Formula: Revenue − Cost of Goods Sold. Shows profit after direct delivery costs."}, {"Operating Expenses", 4, "Operating Expenses  ⓘ", "Indirect costs of running the business, excluding Cost of Goods Sold and non-operating items."}, {"Operating Profit", 5, "Operating Profit  ⓘ", "Formula: Gross Profit − Operating Expenses. Shows profit generated by core operations."}, {"Other Income", 6, "Other Income  ⓘ", "Income outside core operations, such as interest earned or other non-operating gains."}, {"Other Expenses", 7, "Other Expenses  ⓘ", "Expenses outside core operations, excluding the operating costs shown above."}, {"Net Profit", 8, "Net Profit  ⓘ", "Formula: Operating Profit + Other Income − Other Expenses. Represents profit after operating and non-operating items."}, {"Depreciation add-back", 9, "Depreciation add-back  ⓘ", "Depreciation expense added back because it is a non-cash charge used in the EBITDA calculation."}, {"Less: Interest Income", 10, "Less: Interest Income  ⓘ", "Interest income removed from Net Profit because EBITDA excludes financing-related income."}, {"EBITDA", 11, "EBITDA  ⓘ", "Formula: Net Profit + Depreciation add-back − Interest Income. Operating taxes and license fees remain in operating expenses."}})

